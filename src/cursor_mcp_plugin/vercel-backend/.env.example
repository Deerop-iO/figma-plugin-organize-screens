# Bonzai (iO-hosted, OpenAI-compatible) credentials. Set these in the Vercel
# project settings for production; for local dev run `vercel env pull .env.local`.
BONZAI_API_KEY=sk-your-key-here
BONZAI_BASE_URL=https://api-v2.bonzai.iodigital.com

# Optional: vision-capable default model. Must support image input. Leave unset
# to use the backend's hardcoded default (claude-sonnet-4-6). Only set this to
# override; an empty value is ignored.
BONZAI_DEFAULT_MODEL=claude-sonnet-4-6

# Optional: override the global system prompt instead of reading
# bonzai-system-prompt.txt from disk.
# BONZAI_SYSTEM_PROMPT=

# Optional production hardening: a shared secret the plugin must send as
# X-Plugin-Token. Leave unset to disable the check (see README).
# PLUGIN_SECRET=
